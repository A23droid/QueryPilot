# QueryPilot — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git (it's already in .gitignore).

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
#
# Local Postgres (default install):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/mydb
#
# Docker one-liner to spin up a test database:
#   docker run --name qp-postgres \
#     -e POSTGRES_PASSWORD=secret \
#     -e POSTGRES_DB=mydb \
#     -p 5432:5432 -d postgres:16
#
# Then use:
DATABASE_URL=postgresql://postgres:secret@localhost:5432/mydb

# ── LLM API Keys (optional — only needed for `qp optimize --suggest`) ────────
# QueryPilot tries keys in this order: Groq → Gemini → OpenAI.
# If none are set the optimize command still works but without AI rewrites.

# Groq (recommended — free tier, fast Llama 3.1 70B model):
# https://console.groq.com/keys
# GROQ_API_KEY=gsk_...

# Google Gemini (gemini-2.0-flash model):
# https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=AI...

# OpenAI (gpt-4o-mini model):
# https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
