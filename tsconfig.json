{
  // Teaching note — tsconfig.json controls how TypeScript compiles your code.
  // Key settings for a Node.js CLI:
  //   "module": "nodenext"  → Use Node.js's native ES module resolution
  //   "target": "esnext"    → Output modern JavaScript (Node 20+ supports it all)
  //   "outDir": "./dist"    → Compiled JS goes in dist/ (not alongside source)
  //   "rootDir": "./src"    → Source files live in src/
  //   "strict": true        → All strict type checks enabled (catches bugs)

  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings — Node.js ESM
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "esnext",

    // Node.js types
    "types": ["node"],
    "lib": ["esnext"],

    // Output
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter checks — catch index access bugs
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Recommended strictness
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
