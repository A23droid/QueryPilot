{
  "name": "querypilot",
  "version": "1.0.0",
  "description": "Catch slow database queries before they reach production. Automated performance testing layer for AI-generated and ORM-generated database code.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "qp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc --outDir dist",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "analyze": "tsx src/index.ts analyze",
    "optimize": "tsx src/index.ts optimize",
    "benchmark": "tsx src/index.ts benchmark",
    "compare": "tsx src/index.ts compare",
    "report": "tsx src/index.ts report",
    "prisma": "tsx src/index.ts prisma",
    "test": "vitest run",
    "mcp": "tsx src/mcp/server.ts",
    "agent": "tsx src/agent.ts"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "explain",
    "performance",
    "prisma",
    "orm",
    "ci",
    "database",
    "query-optimizer"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@armoriq/sdk": "^0.6.10",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "ora": "^9.4.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
